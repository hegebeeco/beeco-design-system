{
  "name": "@beeco/design-system",
  "version": "1.25.0",
  "description": "A beeco egységes design systeme: közös atomok (tokens/), játékbőr (Méhsejt-diorama, web/) és termékbőr (app, admin, partner, web – termek/). Egy forrás, generált kimenetek (CSS, SCSS, Tailwind, Dart).",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:hegebeeco/beeco-design-system",
  "files": [
    "tokens/",
    "dist/",
    "termek/",
    "web/assets/fonts/",
    "tools/ds-lint.js",
    "tools/tokens-build.js",
    "docs/rendszer.md",
    "docs/termek-arculat.md",
    "DESIGN.md",
    "VERSION",
    "web/assets/brand/bee-happy.webp",
    "web/assets/brand/bee-cheer.webp",
    "web/assets/brand/bee-super.webp",
    "web/assets/brand/bee-phone.webp",
    "web/assets/brand/bee-sad.webp",
    "web/assets/brand/moods/",
    "web/assets/brand/roles/",
    "web/assets/brand/logo.webp",
    "web/assets/brand/ikon-32.png",
    "!dist/tesztlapok/",
    "!termek/tesztlapok/",
    "!dist/meh/nezo.png"
  ],
  "exports": {
    "./css/*": "./dist/css/*",
    "./termek.css": "./termek/css/bc-all.css",
    "./termek/*": "./termek/css/*",
    "./scss": "./dist/scss/_beeco.scss",
    "./tailwind": "./dist/tailwind/preset.cjs",
    "./tokens.json": "./dist/tokens.json",
    "./dist/*": "./dist/*",
    "./web/assets/fonts/*": "./web/assets/fonts/*",
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./web/assets/brand/*": "./web/assets/brand/*"
  },
  "bin": {
    "beeco-ds-lint": "tools/ds-lint.js"
  },
  "scripts": {
    "build": "node tools/tokens-build.js && node tools/react-build.js && node tools/webflow-build.js",
    "test": "node tools/tokens-build.js --check && node tools/react-build.js --check && node tools/webflow-build.js --check && for t in tests/check-*.js; do node \"$t\" || exit 1; done",
    "web": "node tools/web-ellenor.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "react-easy-crop": "^5.5.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.24.2",
    "lottie-web": "^5.13.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
