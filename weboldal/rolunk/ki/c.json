  "nev": "c-partner",
  "html": "<section class=\"ds-szekcio\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Szakmai partnerek</div><h2 class=\"ds-cim2\">Egyetemek, szövetségek, civilek</h2></div><div class=\"ds-logosor\"><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/655be59dbcf37965dbacd978_BME.avif\" alt=\"BME\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6898601b5d7743f067271f56_corvinus_logo_HU_rgb.avif\" alt=\"Budapesti Corvinus Egyetem\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/655be59d33216b77d7d0c0b3_ELTE.avif\" alt=\"ELTE TáTK\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/69e7c0409829bccc10978f55_image%201142.png\" alt=\"Pannon Egyetem\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/690ce44fd39e19adc2b77935_Ke%CC%81pernyo%CC%8Bfoto%CC%81%202025-11-06%20-%2019.08.46.avif\" alt=\"Élhető Települések Országos Szövetsége\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/689860eec6b0687b4b3e236d_10milliofa-logo_HU_1.avif\" alt=\"10 millió fa\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/655be59d0e50a670f45ac2db_humusz%202.avif\" alt=\"Humusz Szövetség\" loading=\"lazy\"></div><div class=\"ds-logo\"><img class=\"ds-logo-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/69961e1ccd483154ca3a95a5_Facebook%20Image.png\" alt=\"Tudato