  "nev": "e-kapcs",
  "html": "<section class=\"ds-szekcio ds-hatter-vaj\" id=\"contact\"><div class=\"ds-burok ds-zaro\"><div class=\"ds-szalag\">Let's talk</div><h2 class=\"ds-cim2\">Meet us in Lisbon, or write to us</h2><p class=\"ds-lead ds-zaro-lead\">Bring beeco to your company, city or community. Write to Kristóf Hegedűs, co-founder and CEO: <strong>kristof.hegedus@beeco.hu</strong></p><div class=\"ds-gombsor\"><a class=\"ds-gomb\" href=\"mailto:kristof.hegedus@beeco.hu?subject=Web%20Summit%20%E2%80%93%20beeco\">Email us</a><a class=\"ds-gomb ds-masod\" href=\"https://www.beeco.hu/letoltes?utm_source=websummit&amp;utm_medium=en&amp;utm_campaign=zaro\">Get the app</a><a class=\"ds-gomb ds-masod\" href=\"/\">Magyarul</a></div></div></section>",
