 {
  "nev": "jatek-gyik",
  "html": "<section class=\"ds-szekcio ds-hatter-feher\" id=\"gyik\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Gyakori kérdések</div><h2 class=\"ds-cim2\">Amit a szervezők kérdezni szoktak</h2></div><div class=\"ds-ketto\"><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mire van szükség a helyszínen?</h3><p class=\"ds-szoveg\">Tablet, laptop vagy nagy kijelző böngészővel. Ha nincs stabil internet, előre betöltve is futnak.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Milyen korosztálynak szól?</h3><p class=\"ds-szoveg\">Gyerekeknek és felnőtteknek is: a rövid játékok iskolában és családi napon, a hosszabbak csapatnapon működnek a legjobban.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Kipróbálhatom előre?</h3><p class=\"ds-szoveg\">Igen, a játékok elérhetők a <a class=\"ds-szoveglink\" href=\"https://beeco-szelektalj.netlify.app\" target=\"_blank\" rel=\"noopener\">beeco-szelektalj.netlify.app ›</a> címen.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mennyibe kerül?</h3><p class=\"ds-szoveg\">Az eszközök számától és a program hosszától függ, erre egyedi ajánlatot adunk.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "jatek-tobbi",
  "html": "<section class=\"ds-szekcio ds-hatter-zold\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">További programjaink</div><h2 class=\"ds-cim2\">Ezeket is meghozhatjuk hozzátok</h2></div><div class=\"ds-utak\"><a class=\"ds-ut\" href=\"/szolgaltatas/zold-kviz-okomuki\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcf7d46bae73bbde8f3de_fs-piko-kupa.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Zöld kvíz és ÖkoMuki</h3><p class=\"ds-szoveg\">Humoros, versengő csapatjáték 10–250 főnek, Kahoot alapon.</p><div class=\"ds-tovabb-nyil\">Megnézem ›</div></a><a class=\"ds-ut\" href=\"/szolgaltatas/klimafresko\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfaf356d56416f62a0d9_fs-piko-otlet.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Klímafreskó</h3><p class=\"ds-szoveg\">Tudományos alapú csapatjáték a klímaváltozásról, 3 órában.</p><div class=\"ds-tovabb-nyil\">Megnézem ›</div></a><a class=\"ds-ut\" href=\"/szolgaltatas/csere-bere-szervezes\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfb0356d56416f62a171_fs-piko-sziv.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Csere-bere</h3><p class=\"ds-szoveg\">Ruha-, könyv-, palánta- és játékcsere, családbarát hangulatban.</p><div class=\"ds-tovabb-nyil\">Megnézem ›</div></a></div></div></section>",
  "css": ""
 },
