 {
  "nev": "marketing-hero",
  "html": "<section class=\"ds-szekcio ds-hatter-vaj\" id=\"kezdes\"><div class=\"ds-burok ds-hero-racs\"><div class=\"ds-hero-szoveg\"><div class=\"ds-szalag\">Zöld marketing</div><h1 class=\"ds-cim1\">Zöld üzenet, ami <span class=\"ds-kiemel\">igaz is</span></h1><p class=\"ds-lead\">Stratégia, tartalom, videó és hirdetés egy kézben, fenntartható márkáknak. Csak mért, forrásolt állítást adunk ki, így a kampányod a 2026-os szabályokhoz igazodik.</p><div class=\"ds-gombsor\"><a class=\"ds-gomb\" href=\"#ajanlatkeres\" data-b2b-cta=\"hero\">Ajánlatot kérek</a><a class=\"ds-gomb ds-masod\" href=\"#csomagok\" data-b2b-cta=\"hero-2\">Csomagok</a></div><div class=\"ds-chipsor\"><div class=\"ds-chip\">Videós stáb</div><div class=\"ds-chip\">Igazolt állítások</div><div class=\"ds-chip\">Influencer-együttműködések</div></div></div><figure class=\"ds-foto ds-hero-foto\"><img class=\"ds-foto-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/699b6283f447411e1f6c4196_IMG%202024%20Jan%2023%20%E2%80%93%20nagy.webp\" alt=\"Interjúforgatás egy belső térben, kamerával és fényekkel\" loading=\"lazy\"><figcaption class=\"ds-foto-felirat\">Interjúforgatás</figcaption></figure></div></section>",
  "css": ""
 },
 {
  "nev": "marketing-miert",
  "html": "<section class=\"ds-szekcio ds-hatter-feher\" id=\"miert\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Miért most</div><h2 class=\"ds-cim2\">A zöld kommunikáció szabályai megváltoztak</h2></div><div class=\"ds-ketto\"><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Tilos az üres zöld állítás</h3><p class=\"ds-szoveg\">2026. szeptember 27. óta az EU-ban tilos az általános, nem igazolt környezeti állítás és a kompenzációra épülő állítás.</p><p class=\"ds-forras\"><a class=\"ds-szoveglink\" href=\"https://eur-lex.europa.eu/legal-content/HU/TXT/?uri=CELEX:32024L0825\" target=\"_blank\" rel=\"noopener\">2024/825/EU irányelv ›</a></p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">A jó termék magától nem nő</h3><p class=\"ds-szoveg\">Ha nincs kapacitás házon belül, vagy a termék jó, de nincs növekedés, stratégiával, tartalommal és hirdetéssel segítünk.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "marketing-kap",
  "html": "<section class=\"ds-szekcio\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Mit kapsz</div><h2 class=\"ds-cim2\">Amit a legtöbben kérnek tőlünk</h2></div><div class=\"ds-harom\"><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfaf356d56416f62a0d9_fs-piko-otlet.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Stratégia</h3><p class=\"ds-szoveg\">Audit, célcsoport és üzenetek, 90 napos marketingterv.</p></div><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfb031a1079e200f5490_fs-piko-play.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Tartalom és videó</h3><p class=\"ds-szoveg\">Tartalomterv, grafika, szöveg, rövid videók és márkafilmek.</p></div><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcf7d46bae73bbde8f3de_fs-piko-kupa.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Hirdetés és mérés</h3><p class=\"ds-szoveg\">Meta-, TikTok- és Google-hirdetések, havi riporttal.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "marketing-lepes",
  "html": "<section class=\"ds-szekcio ds-hatter-zold\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Hogyan működik</div><h2 class=\"ds-cim2\">Auditól a havi riportig</h2></div><div class=\"ds-lepesek\"><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">1</div><h3 class=\"ds-cim3\">Audit</h3><p class=\"ds-szoveg\">Megnézzük, hol tart a márkád, és mit állíthatsz igazoltan.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">2</div><h3 class=\"ds-cim3\">Terv</h3><p class=\"ds-szoveg\">90 napos marketingterv célokkal, üzenetekkel, csatornákkal.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">3</div><h3 class=\"ds-cim3\">Gyártás</h3><p class=\"ds-szoveg\">Tartalom, videó, hirdetés és együttműködések.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">4</div><h3 class=\"ds-cim3\">Riport</h3><p class=\"ds-szoveg\">Havi riport és optimalizálás.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "marketing-csomag",
  "html": "<section class=\"ds-szekcio\" id=\"csomagok\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Csomagok</div><h2 class=\"ds-cim2\">Kezdd egy kampányaudittal</h2></div><div class=\"ds-csomagok\"><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Belépő</div><h3 class=\"ds-cim3\">Kampányaudit</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Állítás-ellenőrzés a 2026-os szabályok szerint</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Célcsoport és üzenetek</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Javaslatlista</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"marketing-belépő\">Ajánlatot kérek</a></div><div class=\"ds-csomag ds-csomag-kiemelt\"><div class=\"ds-grafikon-felirat ds-tinta\">Mag</div><h3 class=\"ds-cim3\">Havi tartalom és hirdetés</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Tartalomterv és gyártás</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Hirdetéskezelés</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Havi riport</span></li></ul><a class=\"ds-gomb\" href=\"#ajanlatkeres\" data-b2b-cta=\"marketing-mag\">Ajánlatot kérek</a></div><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Partnerség</div><h3 class=\"ds-cim3\">Szponzoráció egy beeco-kampányban</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Névadó vagy kiemelt támogatás</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Megjelenés az appban és a sajtóban</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Mért eredmények a kampány végén</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"marketing-partnerség\">Ajánlatot kérek</a></div></div></div></section>",
