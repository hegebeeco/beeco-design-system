 {
  "nev": "h-letra",
  "html": "<section class=\"ds-szekcio\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Ajánlati létra</div><h2 class=\"ds-cim2\">Kezdd kicsiben, építkezz együtt velünk</h2><p class=\"ds-lead\">Az első lépés kis kockázat és gyors döntés. Ha működik, rendszeressé tesszük, majd névadó partnerséggé.</p></div><div class=\"ds-csomagok\"><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Belépő</div><h3 class=\"ds-cim3\">Egy program, egy próba</h3><div class=\"ds-csomag-ar\">160 000 Ft-tól</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Egy zöld program vagy locsolónap</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Mi szervezünk mindent</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Hatásjelentés a végén</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"letra-belepo\">Ajánlatot kérek</a></div><div class=\"ds-csomag ds-csomag-kiemelt\"><div class=\"ds-grafikon-felirat ds-tinta\">Mag</div><h3 class=\"ds-cim3\">Rendszeres együttműködés</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Éves előfizetés vagy szezon</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Havi vagy szezonzáró Hatásjelentés</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Kész mondatok a kommunikációhoz</span></li></ul><a class=\"ds-gomb\" href=\"#ajanlatkeres\" data-b2b-cta=\"letra-mag\">Ajánlatot kérek</a></div><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Partnerség</div><h3 class=\"ds-cim3\">Névadó partner</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Saját kampány a nevedhez kötve</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Megjelenés az appban és a sajtóban</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Éves közös tervezés</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"letra-partner\">Ajánlatot kérek</a></div></div><p class=\"ds-megjegyzes\"><strong>Önkormányzatoknak:</strong> a csatlakozás az Önkéntes Vízadáshoz ingyenes, ez a belépő szint.</p></div></section>",
  "css": ".ds-csomagok{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:22px;row-gap:22px;align-items:stretch}.ds-csomag{display:flex;flex-direction:column;align-items:flex-start;row-gap:12px;padding-top:28px;padding-right:26px;padding-bottom:28px;padding-left:26px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:18px;border-top-right-radius:6px;border-bottom-right-radius:18px;border-bottom-left-radius:6px;background-color:var(--_beeco-ds---bc-surface);box-shadow:4px 4px 0 0 #000000;color:var(--_beeco-ds---bc-ink)}.ds-csomag-ar{font-family:Lalezar, \"Arial Black\", sans-serif;font-size:30px;line-height:1.05}.ds-csomag-lista{display:flex;flex-direction:column;row-gap:8px;margin-top:4px;margin-bottom:0px;padding-left:0px;list-style-type:none;font-size:16px;line-height:1.5}.ds-csomag-elem{display:grid;grid-template-columns:22px minmax(0,1fr);column-gap:6px}.ds-csomag-pipa{font-weight:800}.ds-csomag-kiemelt{background-color:var(--_beeco-ds---bc-accent);box-shadow:6px 6px 0 0 #000000;transform:translate(0px,-8px)}@media screen and (max-width: 991px){.ds-csomagok{grid-template-columns:minmax(0,1fr)}.ds-csomag-kiemelt{transform:none}}"
 },
 {
  "nev": "h-lepes",
  "html": "<section class=\"ds-szekcio ds-hatter-zold\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Hogyan dolgozunk</div><h2 class=\"ds-cim2\">Négy lépés az ajánlatkéréstől a jelentésig</h2></div><div class=\"ds-lepesek\"><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">1</div><h3 class=\"ds-cim3\">Írj nekünk</h3><p class=\"ds-szoveg\">Töltsd ki az ajánlatkérőt, és visszahívunk, hogy megismerjük a célod.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">2</div><h3 class=\"ds-cim3\">Megtervezzük</h3><p class=\"ds-szoveg\">Közösen kiválasztjuk a programot, az időpontot és a mérőszámokat.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">3</div><h3 class=\"ds-cim3\">Megcsináljuk</h3><p class=\"ds-szoveg\">Mi szervezünk, a csapatod vagy a lakóid cselekednek, az appban rögzítve.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">4</div><h3 class=\"ds-cim3\">Megkapod a jelentést</h3><p class=\"ds-szoveg\">Számok, forrás, módszer és kész mondatok a kommunikációdhoz.</p></div></div></div></section>",
  "css": ".ds-lepesek{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:22px;row-gap:28px}.ds-lepes{display:flex;flex-direction:column;align-items:flex-start;row-gap:10px}.ds-lepes-szam{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-top-left-radius:999px;border-top-right-radius:999px;border-bottom-right-radius:999px;border-bottom-left-radius:999px;background-color:#000000;color:var(--_beeco-ds---bc-accent);font-family:Lalezar, \"Arial Black\", sans-serif;font-size:26px;line-height:1}@media screen and (max-width: 991px){.ds-lepesek{grid-template-columns:repeat(2,minmax(0,1fr))}}@media screen and (max-width: 767px){.ds-lepesek{grid-template-columns:minmax(0,1fr)}}"
 },
 {
  "nev": "h-jelentes",
  "html": "<section class=\"ds-szekcio ds-hatter-feher\" id=\"hatasjelentes\"><div class=\"ds-burok ds-ketto\"><div class=\"ds-hero-szoveg\"><div class=\"ds-szalag\">Hatásjelentés</div><h2 class=\"ds-cim2\">Minden fizetős csomaghoz jár</h2><p class=\"ds-lead\">Egységes sablon, csomagonként más adattal, PDF-ben és linken. Ebből látod, mit értetek el, és azt is, mit mondhatsz róla.</p><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Mért adatok: résztvevők, órák, liter, fa, odú, kihívás</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Forrás és módszer minden számhoz</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Kapcsolódás az SDG-khez és a VSME-adatpontokhoz</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Kész mondatok, amiket jogszerűen használhatsz</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Lábnyom-változás csak becsültként, a kalkulátor módszertanával</span></li></ul><p class=\"ds-szoveg\">Adatot adunk a jelentésedhez. Megfelelést nem ígérünk, azt a riportod adja.</p></div><div class=\"ds-jelentes\"><div class=\"ds-jelentes-fej\"><div class=\"ds-grafikon-felirat\">Hatásjelentés · Minta</div><h3 class=\"ds-cim3\">Locsolóraj 2026 · Minta Példa Kft.</h3><p class=\"ds-szoveg\">3 locsolónap, Budapest</p></div><div class=\"ds-jelentes-szamok\"><div class=\"ds-jelentes-szam\"><div class=\"ds-jelentes-ertek\">12 400</div><div class=\"ds-szoveg\">liter víz a fiatal fáknak</div></div><div class=\"ds-jelentes-szam\"><div class=\"ds-jelentes-ertek\">42</div><div class=\"ds-szoveg\">megöntözött fa, a térképen ellenőrizhető</div></div><div class=\"ds-jelentes-szam\"><div class=\"ds-jelentes-ertek\">38</div><div class=\"ds-szoveg\">résztvevő munkatárs</div></div><div class=\"ds-jelentes-szam\"><div class=\"ds-jelentes-ertek\">114</div><div class=\"ds-szoveg\">önkéntes óra</div></div></div><p class=\"ds-szoveg\"><strong>Módszer:</strong> öntözések az appban rögzítve, fotóval; a fák a FŐKERT fakataszteréből. Kapcsolódás: SDG 11, 13, 15; VSME: munkavállalói önkéntesség, helyi közösség.</p><p class=\"ds-allitas\"><strong>Mondhatod:</strong> „Munkatársaink 2026 nyarán 12 400 liter vizet adtak 42 fiatal fának Budapesten.”</p><p class=\"ds-allitas ds-allitas-kerul\"><strong>Kerüld:</strong> „Környezetbarát cég vagyunk.” Általános, nem igazolt állítás.</p><p class=\"ds-forras\">A számok mintaadatok, nem valódi ügyfél eredményei.</p></div></div></section>",
  "css": ".ds-jelentes{display:flex;flex-direction:column;row-gap:16px;padding-top:28px;padding-right:28px;padding-bottom:28px;padding-left:28px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:18px;border-top-right-radius:6px;border-bottom-right-radius:18px;border-bottom-left-radius:6px;background-color:var(--_beeco-ds---bc-paper);box-shadow:6px 6px 0 0 #000000;transform:rotate(0.6deg)}.ds-jelentes-fej{display:flex;flex-direction:column;row-gap:4px;padding-bottom:14px;border-bottom-style:dashed;border-bottom-width:2px;border-bottom-color:#000000}.ds-jelentes-szamok{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:14px;row-gap:14px}.ds-jelentes-szam{display:flex;flex-direction:column;row-gap:2px;padding-top:12px;padding-right:14px;padding-bottom:12px;padding-left:14px;border-left-style:solid;border-left-width:4px;border-left-color:var(--_beeco-ds---bc-accent);background-color:var(--_beeco-ds---bc-surface)}.ds-jelentes-ertek{font-family:Lalezar, \"Arial Black\", sans-serif;font-size:32px;line-height:1}.ds-allitas{padding-top:12px;padding-right:14px;padding-bottom:12px;padding-left:14px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:12px;border-top-right-radius:4px;border-bottom-right-radius:12px;border-bottom-left-radius:4px;background-color:var(--_beeco-ds---bc-surface-2);font-size:15px;line-height:1.5}.ds-allitas-kerul{border-top-style:dashed;border-right-style:dashed;border-bottom-style:dashed;border-left-style:dashed;background-color:var(--_beeco-ds---bc-surface);color:var(--_beeco-ds---bc-ink-soft)}@media screen and (max-width: 767px){.ds-jelentes{transform:none}.ds-jelentes-szamok{grid-template-columns:minmax(0,1fr)}}"
 },
 {
  "nev": "h-szam",
  "html": "<section class=\"ds-szekcio ds-hatter-sotet\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Bizonyíték</div><h2 class=\"ds-cim2\">Amit eddig közösen elértünk</h2></div><div class=\"ds-szamsav\"><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">15</div><div class=\"ds-szam-felirat\">partner-önkormányzat</div></div><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">784 352</div><div class=\"ds-szam-felirat\">liter víz a fiatal fáknak 2026 nyarán</div></div><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">2 162</div><div class=\"ds-szam-felirat\">vízadó 2026-ban</div></div><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">1.200+</div><div class=\"ds-szam-felirat\">résztvevő a programjainkon</div></div><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">400+</div><div class=\"ds-szam-felirat\">Klímafreskó-résztvevő</div></div><div class=\"ds-szam\"><div class=\"ds-szam-ertek\">25.000+</div><div class=\"ds-szam-felirat\">letöltés</div></div></div><p class=\"ds-forras ds-forras-sotet\">Források: beeco kampányzárás (Vízadás 2026), beeco belső adatok, App Store és Google Play adatlap, 2026. október.</p></div></section>",
  "css": ""
 },
 {
  "nev": "h-eset",
  "html": "<section class=\"ds-szekcio\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Esettanulmány</div><h2 class=\"ds-cim2\">Önkéntes Vízadás: egy város, egy nyár, sok kanna</h2></div><div class=\"ds-eset\"><div class=\"ds-eset-resz\"><div class=\"ds-grafikon-felirat\">Kihívás</div><p class=\"ds-szoveg\">Aszályos nyarak, kiszáradó fiatal fák, és kevés eszköz arra, hogy a lakók bekapcsolódjanak.</p></div><div class=\"ds-eset-resz\"><div class=\"ds-grafikon-felirat\">Megoldás</div><p class=\"ds-szoveg\">A beeco appban a lakók a térképen találják meg a szomjas fákat, rögzítik az öntözést, és nektárt gyűjtenek érte. Partnereink a FŐKERT és a 10 millió Fa.</p><a class=\"ds-szoveglink\" href=\"https://telex.hu/belfold/2025/09/21/aszaly-onkentes-vizadas-locsolakoma-fokert-beeco-10-millio-fa-eredmenyek\" target=\"_blank\" rel=\"noopener\">Telex: az első év eredményei ›</a></div><div class=\"ds-eset-eredmeny\"><div class=\"ds-grafikon-felirat ds-forras-sotet\">Eredmény, 2026</div><div><div class=\"ds-szam-ertek\">784 352</div><div class=\"ds-szam-felirat\">liter víz</div></div><div><div class=\"ds-szam-ertek\">2 162</div><div class=\"ds-szam-felirat\">vízadó, 15 településen</div></div></div></div></div></section>",
  "css": ".ds-eset{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,0.8fr);column-gap:28px;row-gap:24px;padding-top:28px;padding-right:28px;padding-bottom:28px;padding-left:28px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:20px;border-top-right-radius:6px;border-bottom-right-radius:20px;border-bottom-left-radius:6px;background-color:var(--_beeco-ds---bc-surface);box-shadow:6px 6px 0 0 #000000}.ds-eset-resz{display:flex;flex-direction:column;row-gap:8px}.ds-eset-eredmeny{display:flex;flex-direction:column;row-gap:14px;padding-top:22px;padding-right:22px;padding-bottom:22px;padding-left:22px;border-top-left-radius:16px;border-top-right-radius:5px;border-bottom-right-radius:16px;border-bottom-left-radius:5px;background-color:#000000;color:#ffffff}@media screen and (max-width: 991px){.ds-eset{grid-template-columns:minmax(0,1fr)}}"
 },
 {
  "nev": "h-gyik",
  "html": "<section class=\"ds-szekcio ds-hatter-feher\" id=\"gyik\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Gyakori kérdések</div><h2 class=\"ds-cim2\">Mielőtt ajánlatot kérsz</h2></div><div class=\"ds-ketto\"><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mennyibe kerül?</h3><p class=\"ds-szoveg\">Minden ajánlat három szinten kérhető. A zöld programok 160 000 Ft-tól indulnak, önkormányzatoknak a Vízadás-csatlakozás ingyenes. A pontos árat a létszám és az időszak alapján adjuk meg.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mennyi időt kér a csapattól?</h3><p class=\"ds-szoveg\">Egy program jellemzően fél nap. Mi szervezünk mindent, a Hatásjelentést is mi írjuk.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Megfelel ez a CSRD-nek?</h3><p class=\"ds-szoveg\">Adatot ad a jelentésedhez, például a VSME munkavállalói és közösségi témáihoz, módszertannal és forrással. Megfelelést nem ígérünk, azt a riportod adja.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mit mondhatunk utána a kommunikációban?</h3><p class=\"ds-szoveg\">Csak mért, forrásolt állítást. A Hatásjelentésben kész mondatokat kapsz, és azt is leírjuk, mit kerülj.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Hogyan mérik az eredményt?</h3><p class=\"ds-szoveg\">A tevékenységeket az appban rögzítjük, fotóval. A fák adatai a FŐKERT fakataszteréből jönnek. Lábnyom-változást csak becsültként, a kalkulátor módszertana szerint közlünk.</p></div><div class=\"ds-kartya\"><h3 class=\"ds-cim3\">Mi történik a munkatársak adataival?</h3><p class=\"ds-szoveg\">A jelentésben csak összesített adat szerepel, név szerinti adat nem. Részletek az <a class=\"ds-szoveglink\" href=\"/privacy-policy\">adatkezelési tájékoztatóban ›</a></p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "h-urlap",
  "html": "<section class=\"ds-szekcio ds-hatter-vaj\" id=\"ajanlatkeres\"><div class=\"ds-burok ds-zaro\"><div class=\"ds-szalag\">Ajánlatkérés</div><h2 class=\"ds-cim2\">Kérj ajánlatot, és indítsuk el a rajt</h2><p class=\"ds-lead ds-zaro-lead\">Pár kérdés, hogy rögtön a neked való csomaggal keressünk. A csillagos mezők kötelezők.</p><div class=\"ds-urlap-doboz w-form\"><form id=\"ajanlatkeres-urlap\" name=\"ajanlatkeres\" data-name=\"Ajánlatkérés\" method=\"get\" class=\"ds-urlap\"><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-nev\">Neved *</label><input class=\"ds-bemenet\" type=\"text\" id=\"ak-nev\" name=\"nev\" autocomplete=\"name\" required></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-ceg\">Cég vagy település *</label><input class=\"ds-bemenet\" type=\"text\" id=\"ak-ceg\" name=\"ceg\" autocomplete=\"organization\" required></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-email\">E-mail-címed *</label><input class=\"ds-bemenet\" type=\"email\" id=\"ak-email\" name=\"email\" autocomplete=\"email\" required></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-tel\">Telefonszám</label><input class=\"ds-bemenet\" type=\"tel\" id=\"ak-tel\" name=\"telefon\" autocomplete=\"tel\"></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-termek\">Mi érdekel? *</label><select class=\"ds-bemenet\" id=\"ak-termek\" name=\"termek\" required><option value=\"\">Válassz</option><option value=\"Települési csomag\">Települési csomag</option><option value=\"beeco@work\">beeco@work</option><option value=\"Locsolóraj\">Locsolóraj</option><option value=\"Madárraj\">Madárraj</option><option value=\"Zöld programok\">Zöld programok</option><option value=\"Partnerprogram\">Partnerprogram</option><option value=\"Zöld marketing\">Zöld marketing</option><option value=\"Még nem tudom\">Még nem tudom</option></select></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-letszam\">Hány embert érint? *</label><select class=\"ds-bemenet\" id=\"ak-letszam\" name=\"letszam\" required><option value=\"\">Válassz</option><option value=\"1–20 fő\">1–20 fő</option><option value=\"21–100 fő\">21–100 fő</option><option value=\"101–500 fő\">101–500 fő</option><option value=\"500 fő felett\">500 fő felett</option><option value=\"Település, lakosság\">Település, lakosság</option></select></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-ido\">Mikor indulnál? *</label><select class=\"ds-bemenet\" id=\"ak-ido\" name=\"idopont\" required><option value=\"\">Válassz</option><option value=\"3 hónapon belül\">3 hónapon belül</option><option value=\"Idén\">Idén</option><option value=\"Jövőre\">Jövőre</option><option value=\"Csak tájékozódom\">Csak tájékozódom</option></select></div><div class=\"ds-mezo\"><label class=\"ds-cimke\" for=\"ak-keret\">Tervezett keret</label><select class=\"ds-bemenet\" id=\"ak-keret\" name=\"keret\"><option value=\"\">Válassz</option><option value=\"300 ezer Ft alatt\">300 ezer Ft alatt</option><option value=\"300 ezer és 1 millió Ft között\">300 ezer és 1 millió Ft között</option><option value=\"1–3 millió Ft\">1–3 millió Ft</option><option value=\"3 millió Ft felett\">3 millió Ft felett</option><option value=\"Még nem tudom\">Még nem tudom</option></select></div><div class=\"ds-mezo ds-mezo-teljes\"><label class=\"ds-cimke\" for=\"ak-uzenet\">Miben segíthetünk?</label><textarea class=\"ds-bemenet ds-szovegdoboz\" id=\"ak-uzenet\" name=\"uzenet\" maxlength=\"2000\"></textarea></div><input type=\"hidden\" name=\"forras\" value=\"cegeknek-hub\"><div class=\"ds-mezo ds-mezo-teljes\"><label class=\"ds-jelolo w-checkbox\"><input class=\"w-checkbox-input\" type=\"checkbox\" id=\"ak-hirlevel\" name=\"b2b_hirlevel\"><span>Kérem a negyedéves B2B hírlevelet eredményekkel és új ajánlatokkal.</span></label><p class=\"ds-forras\">Az adataidat csak az ajánlatkéréshez használjuk. <a class=\"ds-szoveglink\" href=\"/privacy-policy\">Adatkezelési tájékoztató ›</a></p></div><div class=\"ds-mezo ds-mezo-teljes\"><input class=\"ds-gomb\" type=\"submit\" value=\"Ajánlatot kérek\" data-wait=\"Küldés…\" data-b2b-cta=\"urlap\"></div></form><div class=\"ds-urlap-uzenet w-form-done\"><strong>Köszönjük!</strong> Megkaptuk az ajánlatkérésed, hamarosan jelentkezünk.</div><div class=\"ds-urlap-uzenet w-form-fail\">Valami hiba történt a küldéskor. Próbáld újra, vagy írj a hello@beeco.hu címre.</div></div></div></section>",
  "css": ".ds-urlap-doboz{width:100%;max-width:820px;margin-left:auto;margin-right:auto;padding-top:32px;padding-right:32px;padding-bottom:32px;padding-left:32px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:20px;border-top-right-radius:6px;border-bottom-right-radius:20px;border-bottom-left-radius:6px;background-color:var(--_beeco-ds---bc-surface);box-shadow:6px 6px 0 0 #000000;text-align:left}.ds-urlap{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:18px;row-gap:18px}.ds-mezo{display:flex;flex-direction:column;row-gap:6px}.ds-cimke{margin-bottom:0px;color:var(--_beeco-ds---bc-ink);font-size:14px;font-weight:800;line-height:1.3}.ds-bemenet{width:100%;min-height:48px;margin-bottom:0px;padding-top:12px;padding-right:14px;padding-bottom:12px;padding-left:14px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:12px;border-top-right-radius:4px;border-bottom-right-radius:12px;border-bottom-left-radius:4px;background-color:#ffffff;color:var(--_beeco-ds---bc-ink);font-size:16px;line-height:1.4}.ds-bemenet:focus{border-top-color:#000000;border-right-color:#000000;border-bottom-color:#000000;border-left-color:#000000;box-shadow:0 0 0 3px var(--_beeco-ds---bc-accent);outline-style:none}.ds-mezo-teljes{grid-column-start:span 2;grid-column-end:span 2}.ds-szovegdoboz{min-height:120px}.ds-jelolo{display:flex;align-items:flex-start;column-gap:10px;min-height:44px;margin-bottom:0px;padding-left:0px;color:var(--_beeco-ds---bc-ink-soft);font-size:14.5px;line-height:1.5}.ds-urlap-uzenet{padding-top:18px;padding-right:20px;padding-bottom:18px;padding-left:20px;border-top-style:solid;border-top-width:2px;border-top-color:#000000;border-right-style:solid;border-right-width:2px;border-right-color:#000000;border-bottom-style:solid;border-bottom-width:2px;border-bottom-color:#000000;border-left-style:solid;border-left-width:2px;border-left-color:#000000;border-top-left-radius:14px;border-top-right-radius:4px;border-bottom-right-radius:14px;border-bottom-left-radius:4px;background-color:var(--_beeco-ds---bc-surface-2);color:var(--_beeco-ds---bc-ink);font-size:16px;line-height:1.5}@media screen and (max-width: 767px){.ds-urlap-doboz{padding-top:22px;padding-right:18px;padding-bottom:22px;padding-left:18px;}.ds-urlap{grid-template-columns:minmax(0,1fr)}.ds-mezo-teljes{grid-column-start:span 1;grid-column-end:span 1}}"
 }
]