 {
  "nev": "madar-hero",
  "html": "<section class=\"ds-szekcio ds-hatter-vaj\" id=\"kezdes\"><div class=\"ds-burok ds-hero-racs\"><div class=\"ds-hero-szoveg\"><div class=\"ds-szalag\">Madárraj · októbertől márciusig</div><h1 class=\"ds-cim1\">Csapatnap <span class=\"ds-kiemel\">a madarakért</span></h1><p class=\"ds-lead\">Odút és etetőt készítetek, kihelyezitek a telephelyen vagy egy partner-településen, és madársétán megismeritek a lakóit. Szakmai segítséggel, a CsicsergŐsz-kampány részeként.</p><div class=\"ds-gombsor\"><a class=\"ds-gomb\" href=\"#ajanlatkeres\" data-b2b-cta=\"hero\">Ajánlatot kérek</a><a class=\"ds-gomb ds-masod\" href=\"#csomagok\" data-b2b-cta=\"hero-2\">Csomagok</a></div><div class=\"ds-chipsor\"><div class=\"ds-chip\">Októbertől márciusig</div><div class=\"ds-chip\">Fél napos program</div><div class=\"ds-chip\">Szakmai partner: MME</div></div></div><figure class=\"ds-foto ds-hero-foto\"><img class=\"ds-foto-kep\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6ac9369469460ac020d27540_cs-app-terkep.webp\" alt=\"A beeco app térképe madármegfigyelésekkel, itatókkal és odúkkal\" loading=\"lazy\"><figcaption class=\"ds-foto-felirat\">Odúk és etetők a térképen</figcaption></figure></div></section>",
  "css": ""
 },
 {
  "nev": "madar-kap",
  "html": "<section class=\"ds-szekcio\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Mit kapsz</div><h2 class=\"ds-cim2\">Mit csinál a csapatod?</h2></div><div class=\"ds-harom\"><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfae356d56416f62a05f_fs-piko-madarpont.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Odú és etető saját kézzel</h3><p class=\"ds-szoveg\">Előkészített elemekből, szerszámmal és segítséggel. Mindenkinek sikerül.</p></div><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcf7bf218d7e862748bce_fs-piko-fa.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Madárbarát telephely</h3><p class=\"ds-szoveg\">Az odúk és etetők a ti udvarotokba vagy egy partner-településre kerülnek, a térképen jelölve.</p></div><div class=\"ds-kartya\"><img class=\"ds-kartya-piko\" src=\"https://s3.amazonaws.com/webflow-prod-assets/648ebb1f9ae84f3d530e2f2d/6acdcfb0356d56416f62a171_fs-piko-sziv.svg\" alt=\"\" loading=\"lazy\"><h3 class=\"ds-cim3\">Madárséta</h3><p class=\"ds-szoveg\">Szakmai vezetővel megismeritek, kik költözhetnek be az odúkba.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "madar-lepes",
  "html": "<section class=\"ds-szekcio ds-hatter-zold\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Hogyan működik</div><h2 class=\"ds-cim2\">Fél nap, előkészítve</h2></div><div class=\"ds-lepesek\"><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">1</div><h3 class=\"ds-cim3\">Egyeztetünk</h3><p class=\"ds-szoveg\">Létszám, időpont, helyszín: nálatok vagy egy partner-településen.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">2</div><h3 class=\"ds-cim3\">Mi készülünk</h3><p class=\"ds-szoveg\">Anyag, szerszám, szakmai vezető: minden a helyszínre érkezik.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">3</div><h3 class=\"ds-cim3\">Építetek és kihelyeztek</h3><p class=\"ds-szoveg\">Csapatban készülnek az odúk és az etetők, majd a helyükre kerülnek.</p></div><div class=\"ds-lepes\"><div class=\"ds-lepes-szam\">4</div><h3 class=\"ds-cim3\">Megkapod a jelentést</h3><p class=\"ds-szoveg\">Hány odú, etető, résztvevő és óra, fotókkal és kész mondatokkal.</p></div></div></div></section>",
  "css": ""
 },
 {
  "nev": "madar-csomag",
  "html": "<section class=\"ds-szekcio\" id=\"csomagok\"><div class=\"ds-burok\"><div class=\"ds-szekcio-fej\"><div class=\"ds-szalag\">Csomagok</div><h2 class=\"ds-cim2\">Egy délutántól a névadó támogatásig</h2></div><div class=\"ds-csomagok\"><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Belépő</div><h3 class=\"ds-cim3\">Odú- és etetőkészítő délután</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Anyag és szerszám</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Szakmai vezetés</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Rövid jelentés</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"madar-belépő\">Ajánlatot kérek</a></div><div class=\"ds-csomag ds-csomag-kiemelt\"><div class=\"ds-grafikon-felirat ds-tinta\">Mag</div><h3 class=\"ds-cim3\">Madárbarát telephely</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Odúk és etetők a telephelyen</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Madárséta szakmai vezetővel</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Hatásjelentés</span></li></ul><a class=\"ds-gomb\" href=\"#ajanlatkeres\" data-b2b-cta=\"madar-mag\">Ajánlatot kérek</a></div><div class=\"ds-csomag\"><div class=\"ds-grafikon-felirat\">Partnerség</div><h3 class=\"ds-cim3\">CsicsergŐsz-támogató</h3><div class=\"ds-csomag-ar\">Kérj ajánlatot</div><ul class=\"ds-csomag-lista\"><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Névadó támogatás a kampányban</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Megjelenés az appban</span></li><li class=\"ds-csomag-elem\"><span class=\"ds-csomag-pipa\">✓</span><span>Közös sajtó</span></li></ul><a class=\"ds-gomb ds-masod\" href=\"#ajanlatkeres\" data-b2b-cta=\"madar-partnerség\">Ajánlatot kérek</a></div></div></div></section>",
  "css": ""
